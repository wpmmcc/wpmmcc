msgid "WPMMCC"
msgstr "WPMMCC"

#. Description of the plugin
#: wpmmcc.php
msgid ""
"A comprehensive multilingual solution for WordPress with content "
"translation, theme translation, site group management, and multilingual "
"sitemaps."
